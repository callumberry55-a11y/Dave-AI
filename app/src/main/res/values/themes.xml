<resources>

    <style name="Theme.DaveAI" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.DaveAI.Assistant" parent="Theme.DaveAI">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.DaveAI.Widgets.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@android:color/system_accent1_600</item>
    </style>

    <style name="Theme.DaveAI.Widgets.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@android:color/system_accent1_200</item>
    </style>
</resources>